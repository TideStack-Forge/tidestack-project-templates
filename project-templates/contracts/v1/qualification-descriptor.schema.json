{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ouroboros.dev/project-templates/contracts/v1/qualification-descriptor.schema.json",
  "title": "Ouroboros Project Template Qualification Descriptor v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["qualificationDescriptorVersion", "qualificationProfileId", "channel", "scope", "rowId", "templateId", "templateVersion", "artifact", "compatibility", "delivery", "evidence"],
  "properties": {
    "qualificationDescriptorVersion": {"const": "1"},
    "qualificationProfileId": {"type": "string", "minLength": 1, "maxLength": 128},
    "channel": {"enum": ["stable", "preview"]},
    "scope": {"enum": ["MICRO_FRONTEND", "PLATFORM_COMPONENT_LIBRARY", "BACKEND_EXTENSION"]},
    "rowId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,158}[A-Za-z0-9]$"},
    "templateId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,62}(\\.[a-z][a-z0-9-]{1,62})+$",
      "maxLength": 128
    },
    "templateVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[A-Za-z0-9.-]+)?$"},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "compressedSizeBytes", "uncompressedSizeBytes", "manifestSha256"],
      "properties": {
        "sha256": {"$ref": "#/$defs/sha256"},
        "compressedSizeBytes": {"type": "integer", "minimum": 1},
        "uncompressedSizeBytes": {"type": "integer", "minimum": 1},
        "manifestSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["declaredPlatformRange", "testedPlatformVersions", "toolchain"],
      "properties": {
        "declaredPlatformRange": {"type": "string", "minLength": 1, "maxLength": 120},
        "testedPlatformVersions": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1, "maxLength": 64},
          "uniqueItems": true
        },
        "toolchain": {"type": "object"}
      }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deliveryType"],
      "properties": {
        "deliveryType": {"enum": ["MICRO_FRONTEND_APP", "MICRO_FRONTEND_PARCELS", "MICRO_FRONTEND_LIBRARY", "PLATFORM_COMPONENT_LIBRARY", "BACKEND_EXTENSION_JAR"]}
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "sha256"],
        "properties": {
          "name": {"type": "string", "minLength": 1, "maxLength": 128},
          "sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
