{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ouroboros.dev/project-templates/contracts/v1/parameter-contract.schema.json",
  "title": "Ouroboros Project Template Parameter Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "properties", "required", "additionalProperties", "x-ouroboros-project-root"],
  "properties": {
    "$schema": {"type": "string"},
    "type": {"const": "object"},
    "additionalProperties": {"const": false},
    "x-ouroboros-project-root": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
    },
    "required": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$"},
      "uniqueItems": true
    },
    "properties": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/property"}
    }
  },
  "$defs": {
    "property": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "title"],
      "properties": {
        "type": {"enum": ["string", "boolean", "integer"]},
        "title": {"type": "string", "minLength": 1, "maxLength": 120},
        "description": {"type": "string", "maxLength": 1000},
        "default": {},
        "enum": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": ["string", "boolean", "integer"]}
        },
        "minLength": {"type": "integer", "minimum": 0, "maximum": 1000},
        "maxLength": {"type": "integer", "minimum": 1, "maximum": 1000},
        "minimum": {"type": "integer"},
        "maximum": {"type": "integer"},
        "x-ouroboros-format": {
          "enum": [
            "npm-package-name",
            "js-identifier",
            "java-package",
            "java-class-name",
            "maven-group-id",
            "maven-artifact-id",
            "path-segment",
            "relative-path"
          ]
        }
      },
      "allOf": [
        {
          "if": {"properties": {"type": {"const": "string"}}},
          "then": {"required": ["maxLength"]}
        }
      ]
    }
  }
}
