{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ouroboros.dev/project-templates/contracts/v1/catalog.schema.json",
  "title": "Ouroboros Project Template Catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "revision", "sequence", "issuedAt", "expiresAt", "templates"],
  "properties": {
    "contractVersion": {"const": "1"},
    "revision": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,96}$"},
    "sequence": {"type": "integer", "minimum": 1},
    "issuedAt": {"type": "string", "format": "date-time"},
    "expiresAt": {"type": "string", "format": "date-time"},
    "templates": {
      "type": "array",
      "items": {"$ref": "#/$defs/templateRelease"}
    }
  },
  "$defs": {
    "templateId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,62}(\\.[a-z][a-z0-9-]{1,62})+$",
      "maxLength": 128
    },
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "templateRelease": {
      "type": "object",
      "additionalProperties": false,
      "required": ["templateId", "templateVersion", "scope", "displayName", "description", "compatibilityRecords", "artifact", "delivery"],
      "properties": {
        "templateId": {"$ref": "#/$defs/templateId"},
        "templateVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[A-Za-z0-9.-]+)?$"},
        "scope": {"enum": ["MICRO_FRONTEND", "PLATFORM_COMPONENT_LIBRARY", "BACKEND_EXTENSION"]},
        "displayName": {"type": "string", "minLength": 1, "maxLength": 120},
        "description": {"type": "string", "maxLength": 1000},
        "compatibilityRecords": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/compatibilityRecord"}
        },
        "artifact": {
          "type": "object",
          "additionalProperties": false,
          "required": ["uri", "sha256", "compressedSizeBytes", "uncompressedSizeBytes"],
          "properties": {
            "uri": {"type": "string", "format": "uri"},
            "sha256": {"$ref": "#/$defs/sha256"},
            "compressedSizeBytes": {"type": "integer", "minimum": 1},
            "uncompressedSizeBytes": {"type": "integer", "minimum": 1}
          }
        },
        "delivery": {
          "type": "object",
          "additionalProperties": false,
          "required": ["deliveryType"],
          "properties": {
            "deliveryType": {"enum": ["MICRO_FRONTEND_APP", "MICRO_FRONTEND_PARCELS", "MICRO_FRONTEND_LIBRARY", "PLATFORM_COMPONENT_LIBRARY", "BACKEND_EXTENSION_JAR"]}
          }
        }
      }
    },
    "compatibilityRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rowId", "channel", "status", "declaredPlatformRange", "testedPlatformVersions", "toolchain", "certificationEvidence"],
      "properties": {
        "rowId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,158}[A-Za-z0-9]$"},
        "channel": {"enum": ["stable", "preview"]},
        "status": {"enum": ["ACTIVE", "DEPRECATED", "REVOKED"]},
        "declaredPlatformRange": {"type": "string", "minLength": 1, "maxLength": 120},
        "testedPlatformVersions": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1, "maxLength": 64},
          "uniqueItems": true
        },
        "toolchain": {"type": "object"},
        "certificationEvidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["qualificationProfileId", "qualificationDescriptorSha256", "attestationSha256", "attestationKeyId", "ciRunId", "certifiedAt"],
          "properties": {
            "qualificationProfileId": {"type": "string", "minLength": 1, "maxLength": 128},
            "qualificationDescriptorSha256": {"$ref": "#/$defs/sha256"},
            "attestationSha256": {"$ref": "#/$defs/sha256"},
            "attestationKeyId": {"type": "string", "minLength": 1, "maxLength": 64},
            "ciRunId": {"type": "string", "minLength": 1, "maxLength": 128},
            "certifiedAt": {"type": "string", "format": "date-time"}
          }
        }
      }
    }
  }
}
