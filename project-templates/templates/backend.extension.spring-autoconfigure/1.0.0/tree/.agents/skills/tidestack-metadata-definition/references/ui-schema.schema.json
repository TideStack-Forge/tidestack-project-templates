{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tidestack.dev/skills/authoring/ui-schema-resource.schema.json",
  "title": "Typed UI Schema resource envelope",
  "description": "JarUISchemaProvider 对 .ui-schema.json 的 name/schema 包装要求；不是直接渲染组件的属性清单。",
  "type": "object",
  "required": ["name", "schema"],
  "properties": {
    "name": {"type": "string", "pattern": "\\S"},
    "schema": {"type": ["object", "array"], "$ref": "ui-schema-content.schema.json"}
  },
  "additionalProperties": true
}
