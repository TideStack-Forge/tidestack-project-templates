        "properties": {"orderId": {"type": "string", "minLength": 1}}
      }}
    },
    "outputSchema": {"type": "object", "required": ["orderId"], "properties": {"orderId": {"type": "string"}}},
    "binding": {"kind": "handler", "handlerName": "submitOrderHandler"}
  }]
