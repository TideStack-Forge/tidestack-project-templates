{
  "templateId": "frontend.layout.react-webpack",
  "templateVersion": "1.0.0",
  "status": "candidate",
  "scope": "MICRO_FRONTEND",
  "deliveryType": "MICRO_FRONTEND_PARCELS",
  "owner": {
    "team": "Frontend Platform",
    "maintainers": [
      "platform-frontend"
    ],
    "reviewers": [
      "platform-frontend",
      "project-generation"
    ]
  },
  "maintenance": {
    "sourceOfTruth": "project-templates/templates/frontend.layout.react-webpack/1.0.0",
    "upgradePolicy": "Template source and qualification evidence are versioned together. Generated qualification artifacts are rebuilt under project-templates/target and are not committed.",
    "candidateGate": "bash project-templates/scripts/verify-frontend-templates.sh --template frontend.layout.react-webpack --qualification --clean"
  },
  "parameterSchema": {
    "type": "object",
    "x-ouroboros-project-root": "packageName",
    "additionalProperties": false,
    "required": ["packageName"],
    "properties": {
      "packageName": {
        "type": "string",
        "title": "npm 包名",
        "maxLength": 214,
        "x-ouroboros-format": "npm-package-name"
      },
      "topbarTitle": {
        "type": "string",
        "title": "顶栏标题",
        "default": "工作台",
        "maxLength": 40
      },
      "sidebarTitle": {
        "type": "string",
        "title": "侧栏标题",
        "default": "导航",
        "maxLength": 40
      }
    }
  },
  "uiHints": [
    {
      "parameter": "packageName",
      "control": "text",
      "placeholder": "@your-scope/workspace-layout"
    },
    {
      "parameter": "topbarTitle",
      "control": "text"
    },
    {
      "parameter": "sidebarTitle",
      "control": "text"
    }
  ],
  "compatibilityMatrix": {
    "platform": {
      "declaredRange": "[2.0.0-rc.1,2.0.0)",
      "testedVersions": [
        "2.0.0-rc.1-SNAPSHOT"
      ]
    },
    "frontendRuntime": {
      "react": "18.3.x",
      "reactDom": "18.3.x",
      "qiankun": "2.10.x",
      "webpack": "5.108.x",
      "ouroborosSdk": "1.6.0-beta.6",
      "node": "20.x || 22.x"
    },
    "delivery": {
      "type": "MICRO_FRONTEND_PARCELS",
      "bundleFormat": "umd",
      "entries": [
        "topbar",
        "sidebar"
      ],
      "lifecycle": [
        "bootstrap",
        "mount",
        "update",
        "unmount"
      ]
    }
  }
}
